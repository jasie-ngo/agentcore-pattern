mxGeometry height="1190" width="650" x="2437" y="30" as="geometry"/></mxCell><mxCell id="legend-container" connectable="0" style="group" value="" vertex="1" parent="1"><mxGeometry height="1150" width="602" x="2457" y="60" as="geometry"/></mxCell><mxCell id="step-1-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="68" width="600" x="0" y="0" as="geometry"/></mxCell><mxCell id="step-1-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="1" vertex="1" parent="step-1-legend"><mxGeometry height="38" width="40" y="2" as="geometry"/></mxCell><mxCell id="step-1-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Curate sources&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Compliance and ops SMEs add policy documents to an S3 bucket.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-1-legend"><mxGeometry height="68" width="548" x="52" as="geometry"/></mxCell><mxCell id="step-2-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="68" width="600" x="0" y="72" as="geometry"/></mxCell><mxCell id="step-2-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="2" vertex="1" parent="step-2-legend"><mxGeometry height="38" width="40" y="2" as="geometry"/></mxCell><mxCell id="step-2-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Draft&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;An LLM on Amazon Bedrock drafts Gherkin feature files, a glossary and a manifest. It drafts only; nothing is enforced from the draft.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-2-legend"><mxGeometry height="68" width="548" x="52" as="geometry"/></mxCell><mxCell id="step-3-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="68" width="600" x="0" y="144" as="geometry"/></mxCell><mxCell id="step-3-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="3" vertex="1" parent="step-3-legend"><mxGeometry height="38" width="40" y="2" as="geometry"/></mxCell><mxCell id="step-3-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Review and approve&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;SMEs review the feature files as a pull request and approve. The approval record names the approver and the file hash.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-3-legend"><mxGeometry height="68" width="548" x="52" as="geometry"/></mxCell><mxCell id="step-4-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="68" width="600" x="0" y="216" as="geometry"/></mxCell><mxCell id="step-4-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="4" vertex="1" parent="step-4-legend"><mxGeometry height="38" width="40" y="2" as="geometry"/></mxCell><mxCell id="step-4-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Compile and test&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;On merge, CI runs a deterministic compiler (no LLM) and the stage-1 runner. A failing scenario blocks release.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-4-legend"><mxGeometry height="68" width="548" x="52" as="geometry"/></mxCell><mxCell id="step-5-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="68" width="600" x="0" y="288" as="geometry"/></mxCell><mxCell id="step-5-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="5" vertex="1" parent="step-5-legend"><mxGeometry height="38" width="40" y="2" as="geometry"/></mxCell><mxCell id="step-5-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Publish&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Rule pack, Cedar policies and schema, guardrail config, tool schemas and prompt fragments go to S3, versioned and immutable, with hash, approval and test evidence.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-5-legend"><mxGeometry height="68" width="548" x="52" as="geometry"/></mxCell><mxCell id="step-6-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="68" width="600" x="0" y="360" as="geometry"/></mxCell><mxCell id="step-6-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="6" vertex="1" parent="step-6-legend"><mxGeometry height="38" width="40" y="2" as="geometry"/></mxCell><mxCell id="step-6-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Plug points&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The registry feeds Cedar to AgentCore Policy, the guardrail definition to Bedrock, and a pointer plus hash to an AgentCore config bundle.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-6-legend"><mxGeometry height="68" width="548" x="52" as="geometry"/></mxCell><mxCell id="step-7-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="68" width="600" x="0" y="432" as="geometry"/></mxCell><mxCell id="step-7-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="7" vertex="1" parent="step-7-legend"><mxGeometry height="38" width="40" y="2" as="geometry"/></mxCell><mxCell id="step-7-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Ingest&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;A member email lands in the S3 inbox; EventBridge routes the object-created event to the trigger Lambda.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-7-legend"><mxGeometry height="68" width="548" x="52" as="geometry"/></mxCell><mxCell id="step-8-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="68" width="600" x="0" y="504" as="geometry"/></mxCell><mxCell id="step-8-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="8" vertex="1" parent="step-8-legend"><mxGeometry height="38" width="40" y="2" as="geometry"/></mxCell><mxCell id="step-8-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Invoke&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The Lambda invokes AgentCore Runtime with SigV4. Each session runs in its own microVM.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-8-legend"><mxGeometry height="68" width="548" x="52" as="geometry"/></mxCell><mxCell id="step-9-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="68" width="600" x="0" y="576" as="geometry"/></mxCell><mxCell id="step-9-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="9" vertex="1" parent="step-9-legend"><mxGeometry height="38" width="40" y="2" as="geometry"/></mxCell><mxCell id="step-9-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Load, fail closed&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The loader reads the bundle pointer, fetches the pack by hash, and checks hash, approval record and effective date. Any mismatch stops the session.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-9-legend"><mxGeometry height="68" width="548" x="52" as="geometry"/></mxCell><mxCell id="step-10-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="68" width="600" x="0" y="648" as="geometry"/></mxCell><mxCell id="step-10-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="10" vertex="1" parent="step-10-legend"><mxGeometry height="38" width="40" y="2" as="geometry"/></mxCell><mxCell id="step-10-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Decide&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Agents call the decision engine for the routing gate and verification. In-process Cedar checks every tool call: default deny, and errors deny.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-10-legend"><mxGeometry height="68" width="548" x="52" as="geometry"/></mxCell><mxCell id="step-11-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="68" width="600" x="0" y="720" as="geometry"/></mxCell><mxCell id="step-11-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="11" vertex="1" parent="step-11-legend"><mxGeometry height="38" width="40" y="2" as="geometry"/></mxCell><mxCell id="step-11-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Identity and memory&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Python-only code takes a Cognito M2M token via AgentCore Identity and keys AgentCore Memory by the verified member only.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-11-legend"><mxGeometry height="68" width="548" x="52" as="geometry"/></mxCell><mxCell id="step-12-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="68" width="600" x="0" y="792" as="geometry"/></mxCell><mxCell id="step-12-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="12" vertex="1" parent="step-12-legend"><mxGeometry height="38" width="40" y="2" as="geometry"/></mxCell><mxCell id="step-12-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Tool boundary&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Gateway validates the JWT and evaluates the Cedar policy (default deny) before Lambda targets read or write DynamoDB.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-12-legend"><mxGeometry height="68" width="548" x="52" as="geometry"/></mxCell><mxCell id="step-13-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="68" width="600" x="0" y="864" as="geometry"/></mxCell><mxCell id="step-13-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="13" vertex="1" parent="step-13-legend"><mxGeometry height="38" width="40" y="2" as="geometry"/></mxCell><mxCell id="step-13-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Draft the reply&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The Writer runs on Bedrock with the guardrail (no personal financial advice). The draft is shown to staff; nothing is sent to the member.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-13-legend"><mxGeometry height="68" width="548" x="52" as="geometry"/></mxCell><mxCell id="step-14-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="68" width="600" x="0" y="936" as="geometry"/></mxCell><mxCell id="step-14-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="14" vertex="1" parent="step-14-legend"><mxGeometry height="38" width="40" y="2" as="geometry"/></mxCell><mxCell id="step-14-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Escalate&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Escalations are written to DynamoDB and announced by SNS. Staff review the record and the draft, then send.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-14-legend"><mxGeometry height="68" width="548" x="52" as="geometry"/></mxCell><mxCell id="step-15-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="68" width="600" x="0" y="1008" as="geometry"/></mxCell><mxCell id="step-15-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="15" vertex="1" parent="step-15-legend"><mxGeometry height="38" width="40" y="2" as="geometry"/></mxCell><mxCell id="step-15-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Monitor&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Traces carry the rule pack version and hash to CloudWatch. Online evaluations track agreement on the judgement scenarios.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-15-legend"><mxGeometry height="68" width="548" x="52" as="geometry"/></mxCell><mxCell id="legend-line-styles" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fontFamily=Helvetica;fontColor=light-dark(#000000,#FFFFFF);" value="&lt;div&gt;&lt;b&gt;Line styles&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Solid arrow: control or data flow&lt;/div&gt;&lt;div&gt;Dashed arrow: validation, not a data path&lt;/div&gt;&lt;div&gt;Numbers match the steps above&lt;/div&gt;" vertex="1" parent="legend-container"><mxGeometry height="64" width="456" y="1084" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>