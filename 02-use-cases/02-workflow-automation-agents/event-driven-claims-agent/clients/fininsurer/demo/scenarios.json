      "expect": {"policy_number": "POL-10001", "channel": "direct_email", "sender_type": "policyholder", "attachments": 0, "verification_presale": "verified", "verification_strict": "partial", "escalate": false, "hardship": false, "priority_floor": "normal"},
      "backstop_alone": {"escalate": false, "hardship": false}
    },
