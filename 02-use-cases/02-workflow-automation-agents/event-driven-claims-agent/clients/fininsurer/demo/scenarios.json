      "expect": {"policy_number": "POL-10003", "channel": "direct_email", "sender_type": "policyholder", "attachments": 0, "verification_presale": "verified", "verification_strict": "partial", "escalate": true, "hardship": true, "priority_floor": "high"},
      "backstop_alone": {"escalate": false, "hardship": false}
