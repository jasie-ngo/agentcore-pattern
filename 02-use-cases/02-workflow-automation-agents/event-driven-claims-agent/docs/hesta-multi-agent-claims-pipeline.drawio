        <mxCell id="step-7-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Guardrail Check&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;The Writer agent's draft reply is checked against a Bedrock Guardrail that denies personal financial advice&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-7-legend-group">
          <mxGeometry height="80" width="548" x="52" as="geometry" />
        </mxCell>

        <mxCell id="step-8-legend-group" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container">
