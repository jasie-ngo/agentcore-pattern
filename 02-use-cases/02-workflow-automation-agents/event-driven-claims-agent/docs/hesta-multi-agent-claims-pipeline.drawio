        <mxCell id="step-11-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Human-in-the-Loop&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;The human_review tool publishes to an SNS topic, notifying HESTA staff of escalated cases for manual review and reply&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-11-legend-group">
          <mxGeometry height="90" width="548" x="52" as="geometry" />
        </mxCell>

        <mxCell id="legend-note" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Helvetica;" value="&lt;div style=&quot;font-size: 13px;&quot;&gt;&lt;i&gt;The notification tool also sends the staff-approved reply via Amazon SES.&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 13px;&quot;&gt;&lt;i&gt;Failed Trigger invocations land in an SQS dead-letter queue with a CloudWatch alarm; X-Ray traces the Runtime → Gateway → Lambda call chain.&lt;/i&gt;&lt;/div&gt;" vertex="1" parent="legend-container">
