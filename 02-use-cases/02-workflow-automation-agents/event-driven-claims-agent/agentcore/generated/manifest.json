      ],
      "banner_markers": [
        "WARNING:",
        "This email originated from outside",
        "DO NOT click links"
      ],
      "form": {
        "detect": [
          "form based mail",
          "Values:"
        ],
        "values_marker": "Values:",
        "labels": [
          "enquiry-sent-from",
          "email-address",
          "member-number",
          "name",
          "phone",
          "reason-for-enquiry",
          "message"
        ],
        "fields": {
          "id": "member-number",
          "sender_email": "email-address",
          "name": "name",
          "reason": "reason-for-enquiry",
          "message": "message",
          "sender_kind": "enquiry-sent-from"
        },
        "sender_kinds": [
          {
            "contains": "non-member",
            "type": "non_member"
          },
          {
            "contains": "member",
            "type": "member"
          }
        ]
      },
      "id_patterns": [
        {
          "regex": "\\bPOL-[A-Za-z0-9-]+\\b",
          "uppercase": true
        },
        {
          "regex": "member(?:ship)?\\s*(?:number|no\\.?|#)\\s*:?\\s*([A-Za-z0-9-]{3,})",
          "group": 1
        },
        {
          "regex": "\\b\\d{5,9}\\b"
        }
      ],
      "sender_types": [
        {
          "type": "solicitor",
          "channel": "third_party",
          "markers": [
            "we refer to the above matter",
            "our office",
            "solicitor",
            "law firm",
            "lawyers",
            "family law",
            "dear sir/madam"
          ]
        }
      ],
      "default_sender_type": "member"
