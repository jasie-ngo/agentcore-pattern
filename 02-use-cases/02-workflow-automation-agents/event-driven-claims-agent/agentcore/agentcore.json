{
  "name": "ClaimsAgentV2",
  "version": 1,
  "managedBy": "CDK",
  "runtimes": [
    {
      "name": "hestaclaimsagent_v2",
      "description": "Event-driven dual-agent claims processor with confidence-based routing",
      "build": "Container",
      "entrypoint": "main.py",
      "codeLocation": "app/hesta-claimsagent",
      "envVars": [
        {
          "name": "AGENT_OBSERVABILITY_ENABLED",
          "value": "true"
        },
        {
          "name": "OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT",
          "value": "true"
        },
        {
          "name": "AGENT_MODEL_ID",
          "value": "global.anthropic.claude-sonnet-4-6"
        },
        {
          "name": "FAST_MODEL_ID",
          "value": "global.anthropic.claude-haiku-4-5-20251001-v1:0"
        },
        {
          "name": "AUTO_APPROVE_THRESHOLD",
          "value": "80"
        },
        {
          "name": "AGENTCORE_GATEWAY_CREDENTIAL_PROVIDER",
          "value": "cognito-gateway-m2m"
        },
        {
          "name": "AGENTCORE_GATEWAY_OAUTH_SCOPES",
          "value": "agentcore/invoke"
        }
      ],
      "networkMode": "PUBLIC",
      "instrumentation": {
        "enableOtel": true
      },
      "protocol": "HTTP"
    }
  ],
  "memories": [
    {
      "name": "ClaimsAgentMemory",
      "eventExpiryDuration": 90,
      "strategies": [
        {
          "type": "SEMANTIC",
          "name": "semantic_strategy",
          "namespaces": [
            "claims/{actorId}/facts"
          ]
        },
        {
          "type": "SUMMARIZATION",
          "name": "summary_strategy",
          "namespaces": [
            "claims/{actorId}/{sessionId}"
          ]
        }
      ]
    }
  ],
  "knowledgeBases": [],
  "credentials": [
    {
      "authorizerType": "OAuthCredentialProvider",
      "name": "cognito-gateway-m2m",
      "discoveryUrl": "https://cognito-idp.ap-southeast-2.amazonaws.com/ap-southeast-2_5Owf1PdzM/.well-known/openid-configuration",
      "scopes": [
        "agentcore/invoke"
      ],
      "vendor": "CustomOauth2"
    }
  ],
  "evaluators": [
    {
      "name": "ClaimsQualityEvaluator",
      "level": "SESSION",
      "description": "Evaluates claims processing quality including decision accuracy and routing correctness",
      "config": {
        "llmAsAJudge": {
          "model": "global.anthropic.claude-sonnet-4-6",
          "instructions": "Given the following agent session context:\n\n{context}\n\nTool calls made:\n{actual_tool_trajectory}\n\nEvaluate the claims agent response for: 1) correct policy lookup, 2) accurate coverage assessment, 3) appropriate confidence scoring, 4) correct routing decision (auto-approve vs human review). Rate the overall claims processing quality.",
          "ratingScale": {
            "numerical": [
              {
                "value": 1,
                "label": "Poor",
                "definition": "Major errors in processing"
              },
              {
                "value": 2,
                "label": "Below Average",
                "definition": "Some errors or missing steps"
              },
              {
                "value": 3,
                "label": "Average",
                "definition": "Correct but could be more thorough"
              },
              {
                "value": 4,
                "label": "Good",
                "definition": "Accurate processing with clear reasoning"
              },
              {
                "value": 5,
                "label": "Excellent",
                "definition": "Perfect processing with comprehensive analysis"
              }
            ]
          }
        }
      }
    }
  ],
  "onlineEvalConfigs": [
    {
      "name": "ClaimsEvaluation",
      "agent": "hestaclaimsagent_v2",
      "evaluators": [
        "Builtin.Helpfulness",
        "Builtin.Correctness",
        "Builtin.ToolSelectionAccuracy"
      ],
      "samplingRate": 100,
      "description": "Online evaluation for claims agent (3 built-in metrics)"
    }
  ],
  "agentCoreGateways": [
    {
      "name": "ClaimsGateway",
      "description": "MCP Gateway for HESTA member lookup, case lookup and creation, and human-review email drafting",
      "targets": [
        {
          "name": "member-lookup",
          "targetType": "lambdaFunctionArn",
          "lambdaFunctionArn": {
            "lambdaArn": "PLACEHOLDER_MEMBER_LOOKUP",
            "toolSchemaFile": "lambdas/schemas/member_lookup.json"
          }
        },
        {
          "name": "case-lookup-creation",
          "targetType": "lambdaFunctionArn",
          "lambdaFunctionArn": {
            "lambdaArn": "PLACEHOLDER_CASE_LOOKUP_CREATION",
            "toolSchemaFile": "lambdas/schemas/case_lookup_creation.json"
          }
        },
        {
          "name": "email-review",
          "targetType": "lambdaFunctionArn",
          "lambdaFunctionArn": {
            "lambdaArn": "PLACEHOLDER_EMAIL_REVIEW",
            "toolSchemaFile": "lambdas/schemas/email_review.json"
          }
        }
      ],
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "https://cognito-idp.ap-southeast-2.amazonaws.com/ap-southeast-2_5Owf1PdzM/.well-known/openid-configuration",
          "allowedClients": [
            "41ppu6uq1or79jkgrkag8f4rbj"
          ]
        }
      },
      "enableSemanticSearch": true,
      "exceptionLevel": "NONE",
      "policyEngineConfiguration": {
        "policyEngineName": "ClaimsAgentV2PolicyEngine",
        "mode": "ENFORCE"
      }
    }
  ],
  "policyEngines": [
    {
      "name": "ClaimsAgentV2PolicyEngine",
      "description": "Cedar policy engine for claims processing authorization — AllowAll + BlockExcessiveClaims ($100k threshold)",
      "policies": [
        {
          "name": "ClaimsAgentV2AllowAllTools",
          "description": "Permit all tool calls on the claims gateway for authenticated agents",
          "statement": "permit(principal, action, resource is AgentCore::Gateway);",
          "validationMode": "IGNORE_ALL_FINDINGS",
          "enforcementMode": "ACTIVE",
          "authorizationPhase": "INITIATE"
        }
      ]
    }
  ],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [
    {
      "name": "hesta_eval",
      "schemaType": "AGENTCORE_EVALUATION_PREDEFINED_V1",
      "config": {
        "managed": {
          "location": "datasets/hesta_eval.jsonl"
        }
      }
    }
  ],
  "httpGateways": []
}